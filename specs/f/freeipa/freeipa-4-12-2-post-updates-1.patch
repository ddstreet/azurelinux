+
+    def test_totp_expired_ldap(self):
+        master = self.master
+        basedn = master.domain.basedn
+        USER1 = 'user-expired-otp'
+        TMP_PASSWORD = 'Secret1234509'
+        binddn = DN(f"uid={USER1},cn=users,cn=accounts,{basedn}")
